# ── Existing app ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CRON_SECRET=
PRIMARY_COMMISSION_RATE=0.02
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Leverage / prediction-pool engine ────────────────────────────────────
# Signs the short-lived chatroom access tokens issued by /api/access/tier.
TIER_TOKEN_SECRET=

# Verifies inbound YouTube WebSub (PubSubHubbub) push notifications.
# Set when you subscribe: POST to https://pubsubhubbub.appspot.com/subscribe
# with hub.callback=<your-domain>/api/webhooks/youtube and hub.secret=<this value>.
YOUTUBE_PUBSUB_SECRET=

# Verifies inbound Twitch EventSub notifications (set when creating the
# EventSub subscription via the Twitch API — hmac secret you choose).
TWITCH_EVENTSUB_SECRET=

# X (Twitter) API v2 bearer token — used by /api/cron/poll-x and
# /api/pools content-void checks for twitter-platform pools.
X_BEARER_TOKEN=

# Instagram/Facebook Graph API long-lived access token — used by
# /api/cron/poll-instagram and content-void checks for instagram-platform pools.
IG_ACCESS_TOKEN=

# Optional: how often scripts/liveIngest.mjs samples live concurrent-viewer
# metrics, in milliseconds (default 3000).
LIVE_INGEST_INTERVAL_MS=3000
